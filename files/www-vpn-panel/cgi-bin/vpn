<script>
function syncTls(c){var e=c.form&&c.form.querySelector('.tls-extra');if(!e)return;e.hidden=!c.checked}
function eqCards(){
  var cards=[].slice.call(document.querySelectorAll('.vpn>.c'));
  if(!cards.length)return;
  cards.forEach(function(c){c.style.height='auto'});
  var h=0;
  cards.forEach(function(c){if(c.offsetHeight>h)h=c.offsetHeight});
  cards.forEach(function(c){c.style.height=h+'px'});
}
document.querySelectorAll('button.addproxy').forEach(function(b){
  b.addEventListener('click',function(){
    var card=document.getElementById(b.getAttribute('data-card'));
    if(card)card.hidden=false;
    b.hidden=true;
    eqCards();
  });
});
document.querySelectorAll('button.pwt').forEach(function(b){
  b.addEventListener('click',function(){
    var i=b.parentNode.querySelector('input');if(!i)return;
    var show=i.type==='password';i.type=show?'text':'password';b.textContent=show?'hide':'show';
    b.setAttribute('aria-label',show?'Hide password':'Show password');
  });
});
document.querySelectorAll('.advpop').forEach(function(p){
  var btn=p.querySelector('.advbtn');if(!btn)return;
  function setOpen(on){
    p.classList.toggle('open',!!on);
    btn.setAttribute('aria-expanded',on?'true':'false');
  }
  btn.addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();
    var next=!p.classList.contains('open');
    setOpen(next);
    if(!next)btn.blur();
  });
  p.addEventListener('focusout',function(e){if(!p.contains(e.relatedTarget))setOpen(false)});
  document.addEventListener('pointerdown',function(e){if(!p.contains(e.target))setOpen(false)});
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&(p.classList.contains('open')||p.contains(document.activeElement))){setOpen(false);btn.blur()}
  });
});
document.querySelectorAll('.pf input[name=tls]').forEach(function(c){c.addEventListener('change',function(){syncTls(c)});syncTls(c)});
(function(){
  var el=document.getElementById('egress');if(!el)return;
  function fail(){el.textContent='could not determine'}
  var ctl=window.AbortController?new AbortController():null;
  var t=setTimeout(function(){if(ctl)ctl.abort()},8000);
  fetch('?ip',{cache:'no-store',signal:ctl?ctl.signal:undefined}).then(function(r){return r.text()}).then(function(x){
    clearTimeout(t);x=x.trim();
    var pt=el.getAttribute('data-port')||'';
    if(/^(\d{1,3}\.){3}\d{1,3}\$/.test(x))el.textContent=x+(pt?':'+pt:'');else if(/^[0-9A-Fa-f:]+:[0-9A-Fa-f:]+\$/.test(x))el.textContent=pt?'['+x+']:'+pt:x;else fail();
  }).catch(function(){clearTimeout(t);fail()});
})();
(function(){
  var cards=[].slice.call(document.querySelectorAll('.ic'));
  if(!cards.length)return;
  var STG={queued:'starting',checking:'checking the router',resolving:'looking up the latest release',downloading:'downloading',verifying:'verifying the download',unpacking:'unpacking',installing:'installing',restarting:'restarting the running service','pkg-update':'updating package lists','pkg-kernel':'installing the kernel module','pkg-tools':'installing the tools','pkg-ip':'installing ip-full',done:'done'};
  var timer=null;
  function setBtns(off){cards.forEach(function(c){c.querySelector('button.ib').disabled=off})}
  function show(c,o){
    var f=c.querySelector('.ifill'),pc=c.querySelector('.ipct'),tx=c.querySelector('.itxt');
    var st=o&&o.state||'idle',n=o&&o.percent||0;
    c.className='c ic';
    if(st==='running'){f.style.width=n+'%';pc.textContent=n+'%';tx.textContent=(STG[o.stage]||o.stage||'working')}
    else if(o&&o.installed&&(st==='done'||st==='idle')){
      c.className='c ic ok';f.style.width='100%';pc.textContent='100%';
      tx.textContent='Installed'+(o.dnsproxy_version?' \u00b7 naive '+(o.version||'?')+' \u00b7 dnsproxy '+o.dnsproxy_version:(o.version?' \u00b7 version '+o.version:''))}
    else if(o&&o.missing&&st!=='error'){c.className='c ic err';f.style.width='0';pc.textContent='0%';tx.textContent='Not fully installed: '+o.missing+' is missing. Press Install Naive.'}
    else if(st==='error'){c.className='c ic err';f.style.width=n+'%';pc.textContent=n+'%';tx.textContent='Error: '+(o.error||'installation failed')}
    else{f.style.width='0';pc.textContent='0%';tx.textContent='Not installed'}
  }
  // The section lists only the clients that are not installed yet. A card stays while its install runs
  // or failed, shows "done" for a moment at 100%, then goes away; with nothing left the section is removed.
  var sec=document.getElementById('install'),gone=0,seen={};
  function drop(c){
    if(c.getAttribute('data-gone'))return;
    c.setAttribute('data-gone','1');c.style.display='none';gone++;
    if(gone>=cards.length&&sec&&sec.parentNode){clearTimeout(timer);sec.parentNode.removeChild(sec)}
  }
  function poll(){
    fetch('?install-status',{cache:'no-store'}).then(function(r){return r.json()}).then(function(j){
      var run=false;
      cards.forEach(function(c){
        if(c.getAttribute('data-gone'))return;
        var p=c.getAttribute('data-p'),o=j[p],st=o&&o.state||'idle';
        if(st==='running')run=true;
        if(o&&o.installed&&st!=='running'&&st!=='error'){
          if(seen[p]){show(c,o);if(!c.getAttribute('data-fade')){c.setAttribute('data-fade','1');setTimeout(function(){drop(c)},2500)}}
          else drop(c);
        }else{seen[p]=1;show(c,o)}
      });
      if(sec&&sec.parentNode&&gone<cards.length)sec.hidden=false;
      setBtns(run);
      clearTimeout(timer);
      if(run||cards.some(function(c){return c.getAttribute('data-fade')&&!c.getAttribute('data-gone')}))timer=setTimeout(poll,run?1500:3000);
    }).catch(function(){clearTimeout(timer);timer=setTimeout(poll,4000)});
  }
  cards.forEach(function(c){
    c.querySelector('button.ib').addEventListener('click',function(){
      var p=c.getAttribute('data-p');
      seen[p]=1;setBtns(true);
      show(c,{state:'running',percent:0,stage:'queued'});
