#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/xray run -c /etc/xray/config.json
  procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  if [ -f /etc/xray/tproxy.disabled ]; then /etc/xray/tproxy.sh down; else /etc/xray/tproxy.sh up; fi
}
stop_service() {
  /etc/xray/tproxy.sh down
}
