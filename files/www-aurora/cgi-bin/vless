button.add:hover{background:#e3f2fd}
</style></head><body>
HTML
if [ -n "$WHY" ]; then
  echo "<div class=banner><div class=why>$(printf '%s' "$WHY" | esc)</div><div class=how>$(printf '%s' "$HOW" | esc)</div></div>"
fi
echo '<h2>Aurora router panel</h2>'
[ -n "$MSG" ] && echo "<div class=msg>$(printf '%s' "$MSG" | esc)</div>"
cat <<HTML
<div class=c id=status><table>
<tr><td>Mode:</td><td><form method=post class=modef><input type=hidden name=action value=mode>
<select name=mode><option value=ru $M1>Everything except Russian sites</option><option value=all $M2>Everything through the tunnel</option></select>
<button>Apply</button></form></td></tr>
<tr><td>Transparent mode for the network:</td><td><b style="color:$SC">$ST</b></td></tr>
<tr><td>Service (daemon):</td><td><div class=svcs>$SVC</div></td></tr>
<tr><td>Protocol:</td><td><b>$PN</b></td></tr>
<tr><td>Server:</td><td>$HOST ($SNI)</td></tr>
<tr><td>Egress IP:</td><td id=egress>detecting…</td></tr>
</table></div>
<div class=c style="display:flex;flex-wrap:wrap;gap:8px">
<form method=post><input type=hidden name=action value=on><button style="background:#1a7f37">Enable</button></form>
<form method=post><input type=hidden name=action value=off><button style="background:#c62828">Disable</button></form>
<form method=post><input type=hidden name=action value=test><button>Test connection</button></form>
<form method=post><input type=hidden name=action value=speed><button>Speed</button></form>
</div>
<div class=sec>
<h3>VPN</h3>
<div class="grid vpn">
<div class=c><form method=post><input type=hidden name=proto value=vless><b>vless:// link</b>
HTML
link_field link "$LINK"
au_row vless
cat <<HTML
<div class=btns><button type=submit name=action value=save style="background:#6a1b9a">Connect VLESS</button><button type=submit name=action value=update>Update now</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=naive><b>naive+https:// link</b>
HTML
link_field nv "$NV"
au_row naive
cat <<HTML
<div class=btns><button type=submit name=action value=naivesave style="background:#00695c">Connect Naive</button><button type=submit name=action value=update>Update now</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=hy2><b>hysteria2:// link</b>
HTML
link_field hy2 "$HY2"
au_row hy2
cat <<HTML
<div class=btns><button type=submit name=action value=hy2save style="background:#e65100">Connect Hysteria2</button><button type=submit name=action value=update>Update now</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=wg><b>WireGuard config (.conf)</b>
HTML
link_field wg "$WG" "[Interface]
PrivateKey = ...
Address = ...

[Peer]
PublicKey = ...
Endpoint = ...
AllowedIPs = 0.0.0.0/0"
au_row wg
cat <<HTML
<div class=btns><button type=submit name=action value=wgsave style="background:#283593">Connect WireGuard</button><button type=submit name=action value=update>Update now</button></div></form></div>
</div>
<p class=hint>IPv6 is not proxied.</p>
</div>
<div class=sec>
<h3>Proxy</h3>
<div class="grid proxy">
<div class=pcell>
<button type=button class="add addproxy" data-card=card-socks $SOCKS_BTN_H>Add SOCKS5</button>
<div class=c id=card-socks$SOCKS_CARD_H><form method=post><input type=hidden name=proto value=socks><b>SOCKS5</b>
HTML
proxy_fields socks
cat <<HTML
<div class=btns><button type=submit name=action value=sockssave style="background:#546e7a">Connect SOCKS5</button></div></form></div>
</div>
<div class=pcell>
<button type=button class="add addproxy" data-card=card-http $HTTP_BTN_H>Add HTTP</button>
<div class=c id=card-http$HTTP_CARD_H><form method=post><input type=hidden name=proto value=http><b>HTTP</b>
HTML
proxy_fields http
cat <<HTML
<p class=http-udp>UDP over an HTTP proxy is not supported: QUIC is blocked, other UDP goes direct.</p>
<div class=btns><button type=submit name=action value=httpsave style="background:#0277bd">Connect HTTP</button></div></form></div>
</div>
</div>
<p class=hint>Local proxies for individual apps: SOCKS5 192.168.8.1:10808, HTTP 192.168.8.1:10809.</p>
</div>
<script>
function syncTls(c){var e=c.form&&c.form.querySelector('.tls-extra');if(!e)return;e.hidden=!c.checked}
function eqCards(){
  var cards=[].slice.call(document.querySelectorAll('.vpn>.c'));
  if(!cards.length)return;
  cards.forEach(function(c){c.style.height='auto'});
  var h=0;
  cards.forEach(function(c){if(c.offsetHeight>h)h=c.offsetHeight});
  cards.forEach(function(c){c.style.height=h+'px'});
}
document.querySelectorAll('button.addproxy').forEach(function(b){
  b.addEventListener('click',function(){
    var card=document.getElementById(b.getAttribute('data-card'));
    if(card)card.hidden=false;
    b.hidden=true;
    eqCards();
  });
});
document.querySelectorAll('.pf input[name=tls]').forEach(function(c){c.addEventListener('change',function(){syncTls(c)});syncTls(c)});
(function(){
  var el=document.getElementById('egress');if(!el)return;
  function fail(){el.textContent='could not determine'}
  var ctl=window.AbortController?new AbortController():null;
  var t=setTimeout(function(){if(ctl)ctl.abort()},8000);
  fetch('?ip',{cache:'no-store',signal:ctl?ctl.signal:undefined}).then(function(r){return r.text()}).then(function(x){
    clearTimeout(t);x=x.trim();
    if(/^(\d{1,3}\.){3}\d{1,3}\$/.test(x)||/^[0-9A-Fa-f:]+:[0-9A-Fa-f:]+\$/.test(x))el.textContent=x;else fail();
  }).catch(function(){clearTimeout(t);fail()});
})();
eqCards();
window.addEventListener('resize',eqCards);
</script>
</body></html>
HTML
