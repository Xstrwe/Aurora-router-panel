        if(t.indexOf('ERROR')===0){show(c,{state:'error',percent:0,error:t.replace(/^ERROR:?\s*/,'')});setBtns(false);return}
        poll();
      }).catch(function(){show(c,{state:'error',percent:0,error:'the panel did not answer'});setBtns(false)});
    });
  });
  poll();
})();
eqCards();
window.addEventListener('resize',eqCards);
</script>
