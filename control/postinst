#!/bin/sh
# Runs on the router after install or upgrade. Do not overwrite user state.
[ -n "$IPKG_INSTROOT" ] && exit 0

# When this package replaces vless-router-panel or aurora-router-panel, opkg drops files that both
# packages ship (e.g. /usr/libexec/vpn-panel/*.sh) from our file list while removing the
# old one. Re-add them so that later upgrades and removals work.
OWN=/usr/lib/opkg/info/vpn-panel-gl-inet.list
if [ -f "$OWN" ]; then
	for f in @FILES@; do
		[ -e "$f" ] && { grep -qxF "$f" "$OWN" || echo "$f" >> "$OWN"; }
	done
fi

mkdir -p /etc/xray

# The backend script moved from /etc/xray/vless.sh to /etc/panel/vpn.sh. The old file belongs
# to the package (it is not user state and not a conffile) and opkg normally removes it
# when it replaces the old version; remove a leftover copy. Nothing else calls it, so no
# compatibility link is left. User state under /etc/xray is not touched.
if [ -f /etc/panel/vpn.sh ]; then
	rm -f /etc/xray/vless.sh
fi

if [ ! -f /etc/xray/httpd.conf ]; then
	cat > /etc/xray/httpd.conf <<'CONF'
# Authentication for the vpn.panel-gl.inet panel (uhttpd basic-auth).
#
# This package does not set a password. Until you add a /rfc2617 line
# below, the page on port 8088 is open to anyone on the LAN (no login).
#
# To enable basic auth:
#   1. Generate a hash on the router:
#        uhttpd -m 'your-password'
#   2. Add a line (replace HASH with the output, and admin with your login):
#        /rfc2617 VLESS admin HASH
#   3. Restart:
#        /etc/init.d/uhttpd restart
#
# Do not put real passwords or hashes into the package or into git.
CONF
fi

if ! grep -qE '^/[^:]*:[^:]+:.+' /etc/xray/httpd.conf 2>/dev/null; then
	echo "WARNING: /etc/xray/httpd.conf has no basic-auth entry; the panel on :8088 is reachable without a password. See the comments in that file."
fi

# Migrate from the old packages (vless-router-panel, aurora-router-panel): their
# uhttpd instances ("vless", "aurora"; same port) are replaced by "vpn_panel",
# keeping a custom listen address. Their old page and helper directories are removed.
LISTEN=''
for OLDS in vless aurora; do
	if uci -q get uhttpd.$OLDS >/dev/null; then
		if [ -z "$LISTEN" ]; then
			LISTEN=$(uci -q get uhttpd.$OLDS.listen_http | head -1)
		fi
		uci -q delete uhttpd.$OLDS
		uci commit uhttpd
	fi
done
[ -n "$LISTEN" ] || LISTEN='192.168.8.1:8088'
if ! uci -q get uhttpd.vpn_panel >/dev/null; then
	uci set uhttpd.vpn_panel=uhttpd
	uci add_list uhttpd.vpn_panel.listen_http="$LISTEN"
	uci set uhttpd.vpn_panel.home='/www-vpn-panel'
	uci set uhttpd.vpn_panel.cgi_prefix='/cgi-bin'
	uci set uhttpd.vpn_panel.config='/etc/xray/httpd.conf'
	uci set uhttpd.vpn_panel.realm='vpn.panel-gl.inet'
	uci set uhttpd.vpn_panel.script_timeout='90'
	uci set uhttpd.vpn_panel.max_requests='3'
	uci commit uhttpd
fi
rm -rf /www-aurora /usr/libexec/aurora-panel

/etc/init.d/uhttpd restart >/dev/null 2>&1 || true

# Upgrade from versions where WireGuard / Hysteria / Naive went through Xray: the
# active protocol is brought up again as its own service (own steering rules), and
# the boot hook that does so after a reboot is enabled. Xray is not touched.
/etc/init.d/aurora-steer enable >/dev/null 2>&1 || true
case "$(cat /etc/xray/proto 2>/dev/null)" in
	hy2|naive|wg)
		/etc/panel/vpn.sh reactivate >/dev/null 2>&1 || echo "WARNING: could not bring the active protocol up as its own service; press Connect on the panel page." ;;
esac

mkdir -p /etc/xray/autoupdate
# Install the hourly autoupdate cron line (idempotent). Does not enable any proto.
if [ -f /usr/libexec/vpn-panel/autoupdate-lib.sh ]; then
	# shellcheck disable=SC1091
	. /usr/libexec/vpn-panel/autoupdate-lib.sh
	au_cron_install
fi
exit 0
