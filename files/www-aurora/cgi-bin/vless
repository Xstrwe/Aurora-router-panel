#!/bin/sh
V=/etc/xray/vless.sh
AU_LIB=/usr/libexec/aurora-panel/autoupdate-lib.sh
# shellcheck disable=SC1090
[ -f "$AU_LIB" ] && . "$AU_LIB"
esc(){ sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
ud(){ printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"; }
fld(){ printf '%s' "$POST" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
# $1 proto: the "Автообновление" row (checkbox + interval, one line) inside a card form
au_row(){
  au_load "$1"
  EN=""; [ "$AU_ENABLED" = 1 ] && EN=checked
  I1=""; I6=""; I24=""
  case "$AU_INTERVAL" in 1h) I1=selected ;; 6h) I6=selected ;; *) I24=selected ;; esac
  cat <<BLK
<div class=au><b>Автообновление</b>
<label><input type=checkbox name=en value=1 $EN> вкл</label>
<label>Интервал <select name=int>
<option value=1h $I1>1 час</option>
<option value=6h $I6>6 часов</option>
<option value=24h $I24>24 часа</option>
</select></label></div>
BLK
}
# $1 proto: text of the link field = subscription URL if one is saved, else the saved link
field_raw(){
  if [ -f "$AU_DIR/$1.src" ]; then cat "$AU_DIR/$1.src"; else cat "$(au_current_file "$1")"; fi 2>/dev/null
}
# $1 field name, $2 HTML-escaped value, $3 optional raw placeholder.
# Empty saved value: hide the field and show "Добавить"; the button reveals it.
link_field(){
  _n="$1"; _v="$2"; _ph="$3"
  _ta_h=; _btn_h=hidden
  [ -z "$(printf '%s' "$_v" | tr -d '\r\n\t ')" ] && { _ta_h=hidden; _btn_h=; }
  _pha=
  if [ -n "$_ph" ]; then
    _pha=" placeholder=\"$(printf '%s' "$_ph" | esc)\""
  fi
  cat <<BLK
<div class=fld><textarea name=$_n spellcheck=false$_pha $_ta_h>$_v</textarea>
<button type=button class=add $_btn_h>Добавить</button></div>
BLK
}
# $1 proto socks|http — separate fields; empty saved config: hide and show "Добавить"
proxy_fields(){
  F=/etc/xray/$1.json
  ADDR=; PORT=; USER=; PASS=; SNI=; TLS=; INS=
  PF_H=hidden; ADD_H=
  if [ -s "$F" ]; then
    ADDR=$(jq -r '.address // empty' "$F" | esc)
    PORT=$(jq -r '.port // empty' "$F" | esc)
    USER=$(jq -r '.user // empty' "$F" | esc)
    PASS=$(jq -r '.pass // empty' "$F" | esc)
    SNI=$(jq -r '.sni // empty' "$F" | esc)
    [ "$(jq -r '.tls // false' "$F")" = true ] && TLS=checked
    [ "$(jq -r '.allowInsecure // false' "$F")" = true ] && INS=checked
    PF_H=; ADD_H=hidden
  fi
  cat <<BLK
<div class=pf $PF_H>
<label>Адрес <input type=text name=addr value="$ADDR" autocomplete=off spellcheck=false></label>
<label>Порт <input type=text name=port value="$PORT" inputmode=numeric autocomplete=off></label>
<label>Логин <input type=text name=user value="$USER" autocomplete=off spellcheck=false></label>
<label>Пароль <input type=password name=pass value="$PASS" autocomplete=new-password></label>
BLK
  if [ "$1" = http ]; then
    cat <<BLK
<label class="chk span2"><input type=checkbox name=tls value=1 $TLS> TLS</label>
<div class="tls-extra span2" style="display:contents">
<label>SNI <input type=text name=sni value="$SNI" autocomplete=off spellcheck=false></label>
<label class=chk><input type=checkbox name=insecure value=1 $INS> не проверять сертификат</label>
</div>
BLK
  fi
  cat <<BLK
</div>
<button type=button class=add $ADD_H>Добавить</button>
BLK
}
MSG=""
if [ "$REQUEST_METHOD" = POST ]; then
  POST=$(head -c "${CONTENT_LENGTH:-0}")
  A=$(fld action)
  case "$A" in
    on|off) MSG=$($V $A 2>&1);;
    mode) MSG=$($V mode "$(fld mode)" 2>&1);;
    test) T=$(curl -s -o /dev/null -m 10 -w '%{http_code} %{time_total}' --socks5-hostname 127.0.0.1:10808 https://www.google.com/generate_204 2>/dev/null)
      Y=$(curl -s -o /dev/null -m 10 -w '%{http_code}' --socks5-hostname 127.0.0.1:10808 https://www.youtube.com 2>/dev/null)
      IPX=$(curl -s -m 8 --socks5-hostname 127.0.0.1:10808 https://api.ipify.org 2>/dev/null)
      set -- $T
      if [ "$1" = 204 ]; then MSG="Тест: подключение есть ✅
Задержка: $(awk "BEGIN{printf \"%d\", $2*1000}") мс
IP выхода: ${IPX:-?}
YouTube: $([ "$Y" = 200 ] && echo открывается || echo "код $Y")"
      else MSG="Тест: нет подключения ❌ (код ${1:-нет ответа})"; fi;;
    speed) PNX=VLESS; grep -q hy2 /etc/xray/proto 2>/dev/null && PNX=Hysteria2; grep -q naive /etc/xray/proto 2>/dev/null && PNX=Naive; grep -q wg /etc/xray/proto 2>/dev/null && PNX=WireGuard; grep -q socks /etc/xray/proto 2>/dev/null && PNX=SOCKS5; grep -q http /etc/xray/proto 2>/dev/null && PNX=HTTP; R=$(curl -s -o /dev/null -m 20 -w '%{speed_download} %{size_download}' --socks5-hostname 127.0.0.1:10808 'https://speed.cloudflare.com/__down?bytes=50000000' 2>/dev/null)
      set -- $R
      if [ "${2%.*}" -gt 100000 ] 2>/dev/null; then MSG="Скорость ($PNX): $(awk "BEGIN{printf \"%.1f\", $1*8/1000000}") Мбит/с (скачано $(awk "BEGIN{printf \"%.1f\", $2/1048576}") МБ)"
      else MSG="Скорость: не удалось измерить ❌"; fi;;
    proto) MSG=$($V proto "$(fld proto)" 2>&1);;
    save|hy2save|naivesave|wgsave|update)
      # One form per protocol card: link field + auto-update row + two buttons.
      AP=$(fld proto)
      case "$AP" in vless) FN=link; CMD=save;; hy2) FN=hy2; CMD=hy2save;; naive) FN=nv; CMD=naivesave;; wg) FN=wg; CMD=wgsave;; *) AP=""; MSG="ERROR: неизвестный протокол";; esac
      if [ -n "$AP" ]; then
        EN=0; [ "$(fld en)" = 1 ] && EN=1
        INT=$(fld int); case "$INT" in 1h|6h|24h) ;; *) INT=24h;; esac
        MSG=$($V autoset "$AP" "$EN" "$INT" 2>&1)
        case "$MSG" in *ERROR*) ;; *)
          IN=/tmp/cgi-$AP.in; OUT=/tmp/cgi-$AP.out
          ud "$(fld $FN)" > $IN
          NEW=$(tr -d '\r\n\t ' < $IN)
          OLD=$(field_raw "$AP" | tr -d '\r\n\t ')
          if [ "$A" = update ] && { [ -z "$NEW" ] || [ "$NEW" = "$OLD" ]; }; then
            # Nothing new in the field: just re-fetch from the saved link.
            MSG=$($V update "$AP" 2>&1)
          elif [ "$A" = update ] && case "$NEW" in http://*|https://*) true;; *) false;; esac; then
            # New subscription URL: save it as the source, then update from it.
            MSG=$($V src "$AP" $IN $OUT 0 2>&1)
            case "$MSG" in *ERROR*) ;; *) MSG=$($V update "$AP" 2>&1);; esac
          else
            # Connect, or "update now" with a new direct link: save it and apply.
            MSG=$($V src "$AP" $IN $OUT 1 2>&1)
            case "$MSG" in *ERROR*) ;; *) MSG=$($V $CMD $OUT 2>&1);; esac
          fi
          rm -f $IN $OUT;;
        esac
      fi;;
    sockssave|httpsave)
      AP=socks; [ "$A" = httpsave ] && AP=http
      IN=/tmp/cgi-$AP.in
      umask 077
      ADDR=$(ud "$(fld addr)")
      PORT=$(ud "$(fld port)")
      USER=$(ud "$(fld user)")
      PASS=$(ud "$(fld pass)")
      if [ "$AP" = http ]; then
        TLS=false; [ "$(fld tls)" = 1 ] && TLS=true
        INS=false; [ "$(fld insecure)" = 1 ] && INS=true
        SNI=$(ud "$(fld sni)")
        jq -n --arg a "$ADDR" --arg p "$PORT" --arg u "$USER" --arg w "$PASS" --argjson tls "$TLS" --arg s "$SNI" --argjson ins "$INS"           '{address:$a,port:$p,user:$u,pass:$w,tls:$tls,sni:$s,allowInsecure:$ins}' > $IN || MSG="ERROR: не удалось собрать настройки"
      else
        jq -n --arg a "$ADDR" --arg p "$PORT" --arg u "$USER" --arg w "$PASS"           '{address:$a,port:$p,user:$u,pass:$w}' > $IN || MSG="ERROR: не удалось собрать настройки"
      fi
      chmod 600 $IN
      if [ -z "$MSG" ]; then
        MSG=$($V $A $IN 2>&1)
      fi
      rm -f $IN;;
  esac
  case "$A" in test|speed|update) ;; *) case "$MSG" in *ERROR*) ;; *) MSG="Готово";; esac;; esac
fi
eval "$($V status | sed 's/^/S_/')"
EXIT=""; [ "$QUERY_STRING" = ip ] && EXIT=$(curl -s -m 8 --socks5-hostname 127.0.0.1:10808 https://api.ipify.org 2>/dev/null)
HY2=$(field_raw hy2 | esc)
NV=$(field_raw naive | esc)
WG=$(field_raw wg | esc)
PN=VLESS; [ "$S_proto" = hy2 ] && PN=Hysteria2; [ "$S_proto" = naive ] && PN=Naive; [ "$S_proto" = wg ] && PN=WireGuard
[ "$S_proto" = socks ] && PN=SOCKS5; [ "$S_proto" = http ] && PN=HTTP
LINK=$(field_raw vless | esc)
case "$S_proto" in
  hy2) F=/etc/xray/hy2.txt;;
  naive) F=/etc/xray/naive.txt;;
  wg|socks|http) F=;;
  *) F=/etc/xray/link.txt;;
esac
if [ -n "$F" ]; then
  HOST=$(sed -E 's#^[a-z0-9+]+://[^@]+@([^/?\#]+).*#\1#' $F 2>/dev/null | head -1 | esc)
  SNI=$(sed -nE 's#.*[?&]sni=([^&\#]+).*#\1#p' $F 2>/dev/null | head -1 | esc)
  [ -n "$SNI" ] || SNI=${HOST%:*}
elif [ "$S_proto" = socks ] || [ "$S_proto" = http ]; then
  HOST=$(jq -r '[.address,(.port|tostring)] | join(":")' /etc/xray/$S_proto.json 2>/dev/null | esc)
  SNI=$(jq -r 'if .tls==true then (.sni // "" | if .=="" then "TLS" else . end) else "без SNI" end' /etc/xray/$S_proto.json 2>/dev/null | esc)
  [ -n "$HOST" ] || HOST="—"
else
  HOST=$(jq -r '.settings.peers[0].endpoint' /etc/xray/wg.json 2>/dev/null | esc)
  SNI="без SNI"
fi
if [ "$S_tproxy" = 1 ] && [ "$S_running" = 1 ]; then ST="ВКЛЮЧЁН"; SC="#1a7f37"; BA=off; BT="Выключить VLESS"; BC="#c62828"
else ST="ВЫКЛЮЧЕН (интернет напрямую)"; SC="#c62828"; BA=on; BT="Включить VLESS"; BC="#1a7f37"; fi
[ "$S_mode" = all ] && { M1=""; M2=selected; } || { M1=selected; M2=""; }
echo "Content-Type: text/html; charset=utf-8"
echo "Cache-Control: no-store"
echo
cat <<HTML
<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aurora router panel</title><style>
body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:1040px;margin:20px auto;padding:0 14px;background:#f4f5f7;color:#222}
.c{background:#fff;border-radius:12px;padding:16px 18px;margin:14px 0;box-shadow:0 1px 4px #0002}
button{border:0;border-radius:10px;color:#fff;background:#1565c0;padding:10px 18px;font-size:16px;cursor:pointer}
.big{width:100%;font-size:22px;padding:18px}textarea{width:100%;box-sizing:border-box;resize:none;overflow:hidden;min-height:2.6em;font-family:monospace;font-size:12px;line-height:1.45;word-break:break-all;field-sizing:content}
select{font-size:16px;padding:6px}.msg{padding:10px;border-radius:8px;background:#fff3cd;white-space:pre-wrap}td{padding:3px 8px 3px 0}
.sec{margin:18px 0 8px}
.sec>h3{margin:0 0 10px;font-size:18px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start;margin:0}
.col{display:flex;flex-direction:column;gap:14px;min-width:0}
.grid .c{margin:0}
@media(max-width:760px){.grid{grid-template-columns:1fr}}
.hint{color:#777;font-size:12px;margin:10px 0 0}
.pf{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;margin-top:8px}
.pf label{display:flex;flex-direction:column;gap:4px;font-size:13px;color:#444}
.pf input[type=text],.pf input[type=password],.pf input[type=number]{font-size:15px;padding:6px 8px;border:1px solid #ccc;border-radius:8px;width:100%;box-sizing:border-box;font-family:inherit}
.pf .chk{flex-direction:row;align-items:center;gap:8px}
.pf .span2{grid-column:1/-1}
.http-udp{color:#777;font-size:12px;margin:10px 0 0}
.au{display:flex;flex-wrap:wrap;align-items:center;gap:4px 14px;margin-top:12px;padding-top:12px;border-top:1px solid #eee;font-size:14px}
.au select{font-size:14px;padding:4px}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.fld{margin-top:6px}
button.add{background:#fff;color:#1565c0;border:1px solid #1565c0;padding:8px 16px;font-size:15px;margin-top:4px}
button.add:hover{background:#e3f2fd}
</style></head><body><h2>Aurora router panel</h2>
HTML
[ -n "$MSG" ] && echo "<div class=msg>$(printf '%s' "$MSG" | esc)</div>"
cat <<HTML
<div class=c><table>
<tr><td>Прозрачный режим для сети:</td><td><b style="color:$SC">$ST</b></td></tr>
<tr><td>Служба Xray:</td><td>$([ "$S_running" = 1 ] && echo работает || echo остановлена)</td></tr>
<tr><td>Протокол:</td><td><b>$PN</b></td></tr>
<tr><td>Сервер:</td><td>$HOST ($SNI)</td></tr>
<tr><td>IP выхода через VLESS:</td><td>$([ -n "$EXIT" ] && printf '%s' "$EXIT" | esc || echo '<a href="?ip">проверить</a>')</td></tr>
</table></div>
<div class=c style="display:flex;flex-wrap:wrap;gap:8px">
<form method=post><input type=hidden name=action value=on><button style="background:#1a7f37">Включить</button></form>
<form method=post><input type=hidden name=action value=off><button style="background:#c62828">Выключить</button></form>
<form method=post><input type=hidden name=action value=test><button>Тест подключения</button></form>
<form method=post><input type=hidden name=action value=speed><button>Скорость</button></form>
</div>
<div class=c><form method=post><input type=hidden name=action value=mode><b>Режим:</b>
<select name=mode><option value=ru $M1>Всё, кроме российских сайтов</option><option value=all $M2>Всё через VLESS</option></select>
<button>Применить</button></form></div>
<div class=sec>
<h3>VPN</h3>
<div class=grid>
<div class=col>
<div class=c><form method=post><input type=hidden name=proto value=vless><b>Ссылка vless://</b>
HTML
link_field link "$LINK"
au_row vless
cat <<HTML
<div class=btns><button type=submit name=action value=save style="background:#6a1b9a">Подключить VLESS</button><button type=submit name=action value=update>Обновить сейчас</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=hy2><b>Ссылка hysteria2://</b>
HTML
link_field hy2 "$HY2"
au_row hy2
cat <<HTML
<div class=btns><button type=submit name=action value=hy2save style="background:#e65100">Подключить Hysteria2</button><button type=submit name=action value=update>Обновить сейчас</button></div></form></div>
</div>
<div class=col>
<div class=c><form method=post><input type=hidden name=proto value=naive><b>Ссылка naive+https://</b>
HTML
link_field nv "$NV"
au_row naive
cat <<HTML
<div class=btns><button type=submit name=action value=naivesave style="background:#00695c">Подключить Naive</button><button type=submit name=action value=update>Обновить сейчас</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=wg><b>Конфиг WireGuard (.conf)</b>
HTML
link_field wg "$WG" "[Interface]
PrivateKey = ...
Address = ...

[Peer]
PublicKey = ...
Endpoint = ...
AllowedIPs = 0.0.0.0/0"
au_row wg
cat <<HTML
<div class=btns><button type=submit name=action value=wgsave style="background:#283593">Подключить WireGuard</button><button type=submit name=action value=update>Обновить сейчас</button></div></form></div>
</div>
</div>
<p class=hint>IPv6 не проксируется.</p>
</div>
<div class=sec>
<h3>Прокси</h3>
<div class=grid>
<div class=c><form method=post><input type=hidden name=proto value=socks><b>SOCKS5</b>
HTML
proxy_fields socks
cat <<HTML
<div class=btns><button type=submit name=action value=sockssave style="background:#546e7a">Подключить SOCKS5</button></div></form></div>
<div class=c><form method=post><input type=hidden name=proto value=http><b>HTTP</b>
HTML
proxy_fields http
cat <<HTML
<p class=http-udp>UDP через HTTP-прокси не поддерживается: QUIC блокируется, остальной UDP идёт напрямую.</p>
<div class=btns><button type=submit name=action value=httpsave style="background:#0277bd">Подключить HTTP</button></div></form></div>
</div>
<p class=hint>Локальные прокси для отдельных программ: SOCKS5 192.168.8.1:10808, HTTP 192.168.8.1:10809.</p>
</div>
<script>
function empty(t){return !t.value.replace(/[\r\n\t ]/g,'')}
function fit(t){if(t.hidden)return;t.style.height='auto';t.style.height=(t.scrollHeight+2)+'px'}
function reveal(b){
  var w=b.parentNode,t=w.querySelector('textarea'),pf=w.querySelector('.pf');
  b.hidden=true;
  if(t){t.hidden=false;if(empty(t)&&t.placeholder)t.rows=t.placeholder.split('\n').length;fit(t);t.focus()}
  if(pf){pf.hidden=false;var i=pf.querySelector('input[name=addr]');if(i)i.focus()}
}
function syncTls(c){var e=c.form&&c.form.querySelector('.tls-extra');if(!e)return;e.hidden=!c.checked}
document.querySelectorAll('.fld').forEach(function(w){var t=w.querySelector('textarea'),b=w.querySelector('.add');t.addEventListener('input',function(){fit(t)});if(empty(t)){t.hidden=true;if(b)b.hidden=false}else{if(b)b.hidden=true;fit(t)}});
window.addEventListener('resize',function(){document.querySelectorAll('textarea').forEach(fit)});
document.querySelectorAll('button.add').forEach(function(b){b.addEventListener('click',function(){reveal(b)})});
document.querySelectorAll('.pf input[name=tls]').forEach(function(c){c.addEventListener('change',function(){syncTls(c)});syncTls(c)});
</script>
</body></html>
HTML
