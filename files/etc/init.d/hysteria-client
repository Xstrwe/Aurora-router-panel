#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/hysteria client -c /etc/hysteria/client.yaml
    # Go 1.24+ listens with MPTCP by default; such a listener cannot rebind a port that still has
    # TIME_WAIT sockets, so a restart under traffic failed with "address already in use".
    procd_set_param env GODEBUG=multipathtcp=0
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
