#!/bin/sh
D=${VLESS_PANEL_DIR:-/etc/xray}
V=${VLESS_SH:-/etc/panel/vpn.sh}
AU_LIB=${VLESS_AU_LIB:-/usr/libexec/vpn-panel/autoupdate-lib.sh}
# shellcheck disable=SC1090
[ -f "$AU_LIB" ] && . "$AU_LIB"
esc(){ sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
# Form-urlencoded value -> raw bytes ("+" = space, %XX = byte). Plain awk, so a typed
# backslash (e.g. in a password) stays a backslash.
ud(){ printf '%s' "$1" | LC_ALL=C awk 'BEGIN{for(i=1;i<256;i++)h[sprintf("%02X",i)]=sprintf("%c",i)}
  {gsub(/\+/," "); s=$0; r=""; while((p=index(s,"%"))>0){x=toupper(substr(s,p+1,2)); if(x in h){r=r substr(s,1,p-1) h[x]; s=substr(s,p+3)} else {r=r substr(s,1,p); s=substr(s,p+1)}} printf "%s",r s}'; }
fld(){ printf '%s' "$POST" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
# $1 proto: the "Auto-update" row (checkbox + interval, one line) inside a card form
au_row(){
  au_load "$1"
  EN=""; [ "$AU_ENABLED" = 1 ] && EN=checked
  I1=""; I6=""; I24=""
  case "$AU_INTERVAL" in 1h) I1=selected ;; 6h) I6=selected ;; *) I24=selected ;; esac
  cat <<BLK
<div class=au><b>Auto-update</b>
<label><input type=checkbox name=en value=1 $EN> on</label>
<label>Interval <select name=int>
<option value=1h $I1>1 hour</option>
<option value=6h $I6>6 hours</option>
<option value=24h $I24>24 hours</option>
</select></label></div>
BLK
}
# $1 proto: text of the link field = subscription URL if one is saved, else the saved link
field_raw(){
  if [ -f "$AU_DIR/$1.src" ]; then cat "$AU_DIR/$1.src"; else cat "$(au_current_file "$1")"; fi 2>/dev/null
}
# $1 field name, $2 HTML-escaped value, $3 optional raw placeholder.
# Always a 2-line field; longer text scrolls inside it.
link_field(){
  _n="$1"; _v="$2"; _ph="$3"
  _pha=
  if [ -n "$_ph" ]; then
    _pha=" placeholder=\"$(printf '%s' "$_ph" | esc)\""
  fi
  cat <<BLK
<div class=fld><textarea name=$_n rows=2 spellcheck=false$_pha>$_v</textarea></div>
BLK
}
# $1 proto socks|http — separate fields, always visible (the card itself is revealed separately)
proxy_fields(){
  F=$D/$1.json
  ADDR=; PORT=; USER=; SNI=; TLS=; INS=
  if [ "$PF_BAD" = "$1" ]; then
    # The save failed: keep what was typed, but never put the password in the page.
    ADDR=$(printf '%s' "$PF_ADDR" | esc); PORT=$(printf '%s' "$PF_PORT" | esc)
    USER=$(printf '%s' "$PF_USER" | esc)
    SNI=$(printf '%s' "$PF_SNI" | esc)
    [ "$PF_TLS" = true ] && TLS=checked
    [ "$PF_INS" = true ] && INS=checked
  elif [ -s "$F" ]; then
    ADDR=$(jq -r '.address // empty' "$F" | esc)
    PORT=$(jq -r '.port // empty' "$F" | esc)
    USER=$(jq -r '.user // empty' "$F" | esc)
    SNI=$(jq -r '.sni // empty' "$F" | esc)
    [ "$(jq -r '.tls // false' "$F")" = true ] && TLS=checked
    [ "$(jq -r '.allowInsecure // false' "$F")" = true ] && INS=checked
  fi
  # Saved password: never written into the HTML. An empty field keeps it.
  PPH="password"
  if [ -s "$F" ] && [ "$(jq -r 'if ((.pass // "") != "") then "1" else "0" end' "$F")" = 1 ]; then
    PPH="•••••••• (saved, leave empty to keep)"
  fi
  cat <<BLK
<div class=pf>
<label>Address <input type=text name=addr value="$ADDR" autocomplete=off spellcheck=false></label>
<label>Port <input type=text name=port value="$PORT" inputmode=numeric autocomplete=off></label>
<label>Login <input type=text name=user value="$USER" autocomplete=off spellcheck=false></label>
<label>Password <span class=pw><input type=password name=pass value="" placeholder="$PPH" autocomplete=new-password><button type=button class=pwt aria-label="Show password">show</button></span></label>
BLK
  if [ "$1" = http ]; then
    TLSX_H=" hidden"; [ -n "$TLS" ] && TLSX_H=
    cat <<BLK
<label class="chk span2"><input type=checkbox name=tls value=1 $TLS> TLS</label>
<div class="tls-extra span2"$TLSX_H>
<label>SNI <input type=text name=sni value="$SNI" autocomplete=off spellcheck=false></label>
<label class=chk><input type=checkbox name=insecure value=1 $INS> do not verify the certificate</label>
</div>
BLK
  fi
  cat <<BLK
</div>
BLK
}
# Naive card: Server and Port stay on the card. Username, Password, Scheme and the
# optional upstream keys, subscription URL and auto-update live in a hover/focus/click
# Advanced pop-up (the Advanced trigger sits in the second row, left column, under
# Server) that does not stretch the card. The saved password is never written into
# the page: the field stays empty and an empty field keeps it.
naive_fields(){
  NJ=$($V naive-show 2>/dev/null)
  nj(){ printf '%s' "$NJ" | jq -r ".$1 // empty" 2>/dev/null; }
  if [ -n "$NV_BAD" ]; then
    N_H=$NV_F_HOST; N_P=$NV_F_PORT; N_U=$NV_F_USER; N_S=$NV_F_SCHEME; N_C=$NV_F_CONC
    N_HD=$NV_F_HDR; N_T=$NV_F_TT; N_I=$NV_F_IT; N_SUB=$NV_F_SUB
  else
    N_H=$(nj host); N_P=$(nj port); N_U=$(nj user); N_S=$(nj scheme); N_C=$(nj concurrency)
    N_HD=$(nj headers); N_T=$(nj tunnel_timeout); N_I=$(nj idle_timeout)
    N_SUB=$(cat "$AU_DIR/naive.src" 2>/dev/null)
  fi
  N_HASP=$(nj has_pass)
  [ -n "$N_P" ] || N_P=443
  S1=selected; S2=; [ "$N_S" = quic ] && { S1=; S2=selected; }
  PPH="password"; [ "$N_HASP" = true ] && PPH="•••••••• (saved, leave empty to keep)"
  ADV_O=; ADV_AX=false; [ "$NV_BAD" = adv ] && { ADV_O=" open"; ADV_AX=true; }
  cat <<BLK
<div class="pf nv">
<label>Server <input type=text name=host value="$(printf '%s' "$N_H" | esc)" placeholder="example.com" autocomplete=off spellcheck=false></label>
<label>Port <input type=text name=port value="$(printf '%s' "$N_P" | esc)" inputmode=numeric autocomplete=off></label>
<div class="advpop$ADV_O">
<button type=button class=advbtn aria-expanded="$ADV_AX" aria-haspopup=true aria-controls=naive-adv>Advanced</button>
<div class=advbox id=naive-adv role=group aria-label="Naive advanced settings">
<div class=pf>
<label>Username <input type=text name=user value="$(printf '%s' "$N_U" | esc)" autocomplete=off spellcheck=false></label>
<label>Password <span class=pw><input type=password name=pass value="" placeholder="$PPH" autocomplete=new-password><button type=button class=pwt aria-label="Show password">show</button></span></label>
<label>Scheme <select name=scheme><option value=https $S1>https (HTTP/2)</option><option value=quic $S2>quic (HTTP/3)</option></select></label>
<label>insecure-concurrency <input type=text name=conc value="$(printf '%s' "$N_C" | esc)" inputmode=numeric placeholder="1 (default)" autocomplete=off></label>
<label>tunnel-timeout, s <input type=text name=tt value="$(printf '%s' "$N_T" | esc)" inputmode=numeric placeholder="1800 (default)" autocomplete=off></label>
<label>idle-timeout, s <input type=text name=it value="$(printf '%s' "$N_I" | esc)" inputmode=numeric placeholder="600 (default)" autocomplete=off></label>
<label class=span2>extra-headers (one per line: Name: value)<textarea name=hdr class=hdr rows=2 spellcheck=false>$(printf '%s' "$N_HD" | esc)</textarea></label>
<label class=span2>Subscription URL (for auto-update) <input type=text name=sub value="$(printf '%s' "$N_SUB" | esc)" placeholder="https://… (optional)" autocomplete=off spellcheck=false></label>
</div>
BLK
  au_row naive
  cat <<BLK
<p class=hint>Auto-update re-reads the subscription URL and applies the naive+https:// link it returns. Without a subscription URL there is nothing to update.</p>
<div class=btns><button type=submit name=action value=naiveupdate>Update now</button></div>
</div>
</div>
</div>
BLK
}
# One entry of the service row: $1 whitelist key, $2 label, $3 1 if running,
# $4 tooltip, $5 "disabled" to grey out the restart button. Running = green,
# not running = red bold (only for the active protocol's daemon; an idle one is grey,
# it is meant to be stopped), then a tiny restart button.
svc_item(){
  if [ "$3" = 1 ]; then
    _st="color:#1a7f37"
  elif [ "$3" = 2 ]; then
    _st="color:#777"
  else
    _st="color:#c62828;font-weight:700"
  fi
  _t=$(printf '%s' "$4" | esc)
  _d=""; _bt="Restart: $2"
  if [ "$5" = disabled ]; then _d=" disabled"; _bt="$4"; fi
  _bt=$(printf '%s' "$_bt" | esc)
  printf '<span class=svc><span style="%s" title="%s">%s</span><form method=post class=svcb><input type=hidden name=action value=restartsvc><input type=hidden name=svc value=%s><button type=submit class=rb%s title="%s" aria-label="Restart %s"><span class=rg>&#8635;</span></button></form></span>' "$_st" "$_t" "$2" "$1" "$_d" "$_bt" "$2"
}
# GET ?ip: the page asks for the egress IP after it has loaded, so a dead tunnel
# never delays the page itself (one probe, 3 s limit, cached for 60 s).
if [ "$REQUEST_METHOD" != POST ] && [ "$QUERY_STRING" = ip ]; then
  echo "Content-Type: text/plain; charset=utf-8"
  echo "Cache-Control: no-store"
  echo
  $V egress 2>/dev/null | tr -d '\r\n\t ' | head -c 80
  exit 0
fi
# GET ?install-status: JSON with installed, version and progress of the four client installs.
# POST ?install (client=xray|hy2|naive|wg): start one install in the background (button-driven).
if [ "$REQUEST_METHOD" != POST ] && [ "$QUERY_STRING" = install-status ]; then
  echo "Content-Type: application/json; charset=utf-8"
  echo "Cache-Control: no-store"
  echo
  $V install-status 2>/dev/null
  exit 0
fi
if [ "$REQUEST_METHOD" = POST ] && [ "$QUERY_STRING" = install ]; then
  POST=$(head -c "${CONTENT_LENGTH:-0}")
  echo "Content-Type: text/plain; charset=utf-8"
  echo "Cache-Control: no-store"
  echo
  case "$(fld client)" in
    xray) $V install xray 2>&1;;
    hy2) $V install hy2 2>&1;;
    naive) $V install naive 2>&1;;
    wg) $V install wg 2>&1;;
    *) echo "ERROR: unknown client";;
  esac
  exit 0
fi
MSG=""
A=""
PF_BAD=""
NV_BAD=""
if [ "$REQUEST_METHOD" = POST ]; then
  POST=$(head -c "${CONTENT_LENGTH:-0}")
  A=$(fld action)
  case "$A" in
    on|off) MSG=$($V $A 2>&1);;
    restartsvc)
      # Fixed whitelist: the value is never passed to the shell as typed.
      case "$(fld svc)" in
        xray) MSG=$($V restart-svc xray 2>&1);;
        naive) MSG=$($V restart-svc naive 2>&1);;
        hysteria) MSG=$($V restart-svc hysteria 2>&1);;
        wireguard) MSG=$($V restart-svc wireguard 2>&1);;
        *) MSG="ERROR: UNKNOWN SERVICE
HINT: USE THE BUTTON NEXT TO A SERVICE NAME";;
      esac;;
    mode) MSG=$($V mode "$(fld mode)" 2>&1);;
    test) T=$($V probe 204 2>/dev/null)
      Y=$($V probe youtube 2>/dev/null)
      IPX=$($V probe ip 2>/dev/null)
      set -- $T
      if [ "$1" = 204 ]; then MSG="Test: connected ✅
Latency: $(awk "BEGIN{printf \"%d\", $2*1000}") ms
Egress IP: ${IPX:-?}
YouTube: $([ "$Y" = 200 ] && echo opens || echo "code $Y")"
      else MSG="Test: no connection ❌ (code ${1:-no response})"; fi;;
    speed) PNX=VLESS; grep -q hy2 $D/proto 2>/dev/null && PNX=Hysteria2; grep -q naive $D/proto 2>/dev/null && PNX=Naive; grep -q wg $D/proto 2>/dev/null && PNX=WireGuard; grep -q socks $D/proto 2>/dev/null && PNX=SOCKS5; grep -q http $D/proto 2>/dev/null && PNX=HTTP; R=$($V probe speed 2>/dev/null)
      set -- $R
      if [ "${2%.*}" -gt 100000 ] 2>/dev/null; then MSG="Speed ($PNX): $(awk "BEGIN{printf \"%.1f\", $1*8/1000000}") Mbit/s (downloaded $(awk "BEGIN{printf \"%.1f\", $2/1048576}") MB)"
      else MSG="Speed: could not measure ❌"; fi;;
    proto) MSG=$($V proto "$(fld proto)" 2>&1);;
    naivesave|naiveupdate)
      # Naive card: fields -> key=value file (0600, never on a command line) -> vpn.sh naivesave.
      umask 077
      one(){ ud "$(fld "$1")" | tr -d '\r\n'; }
      NV_F_HOST=$(one host); NV_F_PORT=$(one port); NV_F_USER=$(one user); NV_F_PASSV=$(one pass)
      NV_F_SCHEME=$(one scheme); case "$NV_F_SCHEME" in https|quic) ;; *) NV_F_SCHEME=https;; esac
      NV_F_CONC=$(one conc); NV_F_TT=$(one tt); NV_F_IT=$(one it)
      NV_F_HDR=$(ud "$(fld hdr)" | tr -d '\r'); NV_F_SUB=$(one sub | tr -d ' \t')
      EN=0; [ "$(fld en)" = 1 ] && EN=1
      INT=$(fld int); case "$INT" in 1h|6h|24h) ;; *) INT=24h;; esac
      IN=/tmp/cgi-naive.in; OUT=/tmp/cgi-naive.out; SUBF=/tmp/cgi-naive.sub
      printf '%s\n' "$NV_F_SUB" > $SUBF
      case "$NV_F_SUB" in ''|http://*|https://*) MSG=$($V autoset naive "$EN" "$INT" 2>&1);;
        *) MSG="ERROR: The subscription URL must start with http:// or https://"; NV_BAD=adv;; esac
      case "$MSG" in *ERROR*) ;; *)
        if [ "$A" = naiveupdate ]; then
          # "Update now": save the subscription URL as the source, then fetch and apply it.
          MSG=$($V src naive $SUBF $OUT 0 2>&1)
          case "$MSG" in *ERROR*) ;; *) MSG=$($V update naive 2>&1);; esac
        elif [ -z "$NV_F_HOST" ] && [ -n "$NV_F_SUB" ]; then
          # Only a subscription URL: take the server from it.
          MSG=$($V src naive $SUBF $OUT 1 2>&1)
          case "$MSG" in *ERROR*) ;; *) MSG=$($V naivesave $OUT 2>&1);; esac
        else
          {
            printf 'host=%s\nport=%s\nuser=%s\npass=%s\nscheme=%s\n' "$NV_F_HOST" "$NV_F_PORT" "$NV_F_USER" "$NV_F_PASSV" "$NV_F_SCHEME"
            printf 'concurrency=%s\ntunnel_timeout=%s\nidle_timeout=%s\n' "$NV_F_CONC" "$NV_F_TT" "$NV_F_IT"
            printf '%s\n' "$NV_F_HDR" | sed 's/^/header=/'
          } > $IN
          MSG=$($V naivesave $IN 2>&1)
          # the subscription URL is remembered for auto-update (an empty field forgets it)
          case "$MSG" in *ERROR*) ;; *) $V src naive $SUBF $OUT 0 >/dev/null 2>&1;; esac
        fi;;
      esac
      rm -f $IN $OUT $SUBF; NV_F_PASSV=
      case "$MSG" in *ERROR*) [ -n "$NV_BAD" ] || NV_BAD=1;; esac;;
    save|hy2save|wgsave|update)
      # One form per protocol card: link field + auto-update row + two buttons.
      AP=$(fld proto)
      case "$AP" in vless) FN=link; CMD=save;; hy2) FN=hy2; CMD=hy2save;; wg) FN=wg; CMD=wgsave;; *) AP=""; MSG="ERROR: unknown protocol";; esac
      if [ -n "$AP" ]; then
        EN=0; [ "$(fld en)" = 1 ] && EN=1
        INT=$(fld int); case "$INT" in 1h|6h|24h) ;; *) INT=24h;; esac
        MSG=$($V autoset "$AP" "$EN" "$INT" 2>&1)
        case "$MSG" in *ERROR*) ;; *)
          IN=/tmp/cgi-$AP.in; OUT=/tmp/cgi-$AP.out
          ud "$(fld $FN)" > $IN
          NEW=$(tr -d '\r\n\t ' < $IN)
          OLD=$(field_raw "$AP" | tr -d '\r\n\t ')
          if [ "$A" = update ] && { [ -z "$NEW" ] || [ "$NEW" = "$OLD" ]; }; then
            # Nothing new in the field: just re-fetch from the saved link.
            MSG=$($V update "$AP" 2>&1)
          elif [ "$A" = update ] && case "$NEW" in http://*|https://*) true;; *) false;; esac; then
            # New subscription URL: save it as the source, then update from it.
            MSG=$($V src "$AP" $IN $OUT 0 2>&1)
            case "$MSG" in *ERROR*) ;; *) MSG=$($V update "$AP" 2>&1);; esac
          else
            # Connect, or "update now" with a new direct link: save it and apply.
            MSG=$($V src "$AP" $IN $OUT 1 2>&1)
            case "$MSG" in *ERROR*) ;; *) MSG=$($V $CMD $OUT 2>&1);; esac
          fi
          rm -f $IN $OUT;;
        esac
      fi;;
    sockssave|httpsave)
      AP=socks; [ "$A" = httpsave ] && AP=http
      IN=/tmp/cgi-$AP.in
      umask 077
      ADDR=$(ud "$(fld addr)")
      PORT=$(ud "$(fld port)")
      USER=$(ud "$(fld user)")
      PASS=$(ud "$(fld pass)")
      TLS=false; INS=false; SNI=
      if [ "$AP" = http ]; then
        [ "$(fld tls)" = 1 ] && TLS=true
        [ "$(fld insecure)" = 1 ] && INS=true
        SNI=$(ud "$(fld sni)")
        jq -n --arg a "$ADDR" --arg p "$PORT" --arg u "$USER" --arg w "$PASS" --argjson tls "$TLS" --arg s "$SNI" --argjson ins "$INS"           '{address:$a,port:$p,user:$u,pass:$w,tls:$tls,sni:$s,allowInsecure:$ins}' > $IN || MSG="ERROR: could not build the settings"
      else
        jq -n --arg a "$ADDR" --arg p "$PORT" --arg u "$USER" --arg w "$PASS"           '{address:$a,port:$p,user:$u,pass:$w}' > $IN || MSG="ERROR: could not build the settings"
      fi
      chmod 600 $IN
      if [ -z "$MSG" ]; then
        MSG=$($V $A $IN 2>&1)
      fi
      rm -f $IN
      PASS=
      case "$MSG" in *ERROR*)
        PF_BAD=$AP; PF_ADDR=$ADDR; PF_PORT=$PORT; PF_USER=$USER
        PF_SNI=$SNI; PF_TLS=$TLS; PF_INS=$INS;;
      esac;;
  esac
  case "$A" in test|speed|update|naiveupdate) ;; *) case "$MSG" in *ERROR*) ;; *) MSG="Done";; esac;; esac
fi
WHY=""; HOW=""
if [ "$A" = restartsvc ]; then
  case "$MSG" in
    *ERROR*)
      WHY=$(printf '%s\n' "$MSG" | sed -n 's/^ERROR: //p' | head -1)
      HOW=$(printf '%s\n' "$MSG" | sed -n 's/^HINT: //p' | head -1)
      [ -n "$HOW" ] || HOW="CHECK LOGREAD -E XRAY AND RESTART AGAIN"
      MSG=""
      ;;
  esac
fi
eval "$($V status | sed 's/^/S_/')"
HEALTH=$($V health 2>/dev/null)
HY2=$(field_raw hy2 | esc)
WG=$(field_raw wg | esc)
# Protocol of the connection the Connect buttons last applied (the proto file), not a fixed VLESS.
case "$S_proto" in
  hy2) PN=Hysteria2;;
  naive) PN=Naive;;
  wg) PN=WireGuard;;
  socks) PN=SOCKS5;;
  http) PN=HTTP;;
  vless) PN=VLESS;;
  *) PN=$(printf '%s' "${S_proto:-—}" | esc);;
esac
LINK=$(field_raw vless | esc)
case "$S_proto" in
  hy2) F=$D/hy2.txt;;
  naive|wg|socks|http) F=;;
  *) F=$D/link.txt;;
esac
# Status card: "Server:" is the active protocol's configured server host only (a bare IP
# when it is configured by IP, never the port); its port goes after the egress IP.
hp_split(){ # host:port, [v6]:port or host -> SRVH / SRVP
  _x=$1
  case "$_x" in
    \[*\]:*) SRVH=${_x%%]*}; SRVH=${SRVH#[}; SRVP=${_x##*]:};;
    \[*\]) SRVH=${_x#[}; SRVH=${SRVH%]}; SRVP=;;
    *:*:*) SRVH=$_x; SRVP=;;
    *:*) SRVH=${_x%:*}; SRVP=${_x##*:};;
    *) SRVH=$_x; SRVP=;;
  esac
}
SRVH=; SRVP=
if [ -n "$F" ]; then
  hp_split "$(sed -nE 's#^[a-z0-9+]+://([^@/?\#]*@)?([^/?\#]+).*#\2#p' $F 2>/dev/null | head -1)"
  [ -n "$SRVP" ] || SRVP=443
elif [ "$S_proto" = naive ]; then
  NSJ=$($V naive-show 2>/dev/null)
  SRVH=$(printf '%s' "$NSJ" | jq -r '.host // empty' 2>/dev/null); SRVP=$(printf '%s' "$NSJ" | jq -r '.port // empty' 2>/dev/null)
elif [ "$S_proto" = socks ] || [ "$S_proto" = http ]; then
  SRVH=$(jq -r '.address // empty' $D/$S_proto.json 2>/dev/null); SRVP=$(jq -r '.port // empty | tostring' $D/$S_proto.json 2>/dev/null)
else
  hp_split "$(jq -r '.settings.peers[0].endpoint // empty' $D/wg.json 2>/dev/null)"
fi
HOST=$(printf '%s' "$SRVH" | esc); [ -n "$HOST" ] || HOST="—"
# digits (a Hysteria port range keeps its commas and dashes) only: it goes into JS-visible HTML
SRVP=$(printf '%s' "$SRVP" | tr -cd '0-9,-' | head -c 40)
# All services behind the VPN cards, always listed. Xray = xray-client, Naive =
# naive-client, Hysteria = hysteria-client, WireGuard = wireguard-client (kernel
# interface wg-aurora; running means the interface is up).
if [ "${S_inst_xray:-0}" != 1 ]; then T_X="not installed"
elif [ "$S_running" = 1 ]; then T_X="running"
else T_X="not running"; fi
if [ "${S_inst_naive:-0}" != 1 ]; then T_N="not installed"; N_UP=0
elif [ "${S_naive:-0}" = 1 ]; then T_N="running"; N_UP=1; else T_N="not running"; N_UP=0; fi
if [ "${S_inst_hysteria:-0}" != 1 ]; then T_H="not installed"; H_UP=0
elif [ "${S_hysteria:-0}" = 1 ]; then T_H="running"; H_UP=1; else T_H="not running"; H_UP=0; fi
W_UP=0; W_DIS=disabled
if [ "${S_inst_wireguard:-0}" != 1 ]; then T_W="not installed (press Install WireGuard)"
elif [ "${S_wg_conf:-0}" != 1 ]; then T_W="config not saved"
elif [ "${S_wireguard:-0}" = 1 ]; then T_W="running"; W_UP=1; W_DIS=
else T_W="not running"; W_DIS=; fi
# A daemon that is not running and is not the active protocol's is idle on purpose: grey, not red.
case "$S_proto" in vless|socks|http) A_X=1;; *) A_X=0;; esac
[ "$S_proto" = naive ] && A_N=1 || A_N=0
[ "$S_proto" = hy2 ] && A_H=1 || A_H=0
[ "$S_proto" = wg ] && A_W=1 || A_W=0
idle_state(){ # $1 up(0|1) $2 tooltip $3 active(0|1) $4 installed-and-configured(0|1) -> 1 | 0 | 2 ; tooltip via T_IDLE
  [ "$1" = 1 ] && { echo 1; return; }
  [ "$4" = 1 ] && [ "$3" = 0 ] && { echo 2; return; }
  echo 0
}
X_UP=0; [ "$S_running" = 1 ] && [ "${S_inst_xray:-0}" = 1 ] && X_UP=1
X_OK=0; [ "${S_inst_xray:-0}" = 1 ] && X_OK=1
N_OK=0; [ "${S_inst_naive:-0}" = 1 ] && N_OK=1
H_OK=0; [ "${S_inst_hysteria:-0}" = 1 ] && H_OK=1
W_OK=0; [ "${S_inst_wireguard:-0}" = 1 ] && [ "${S_wg_conf:-0}" = 1 ] && W_OK=1
[ "$(idle_state "$X_UP" x "$A_X" "$X_OK")" = 2 ] && { X_UP=2; T_X="stopped: not the active protocol"; }
