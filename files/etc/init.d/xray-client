#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/xray run -c /etc/xray/config.json
  # GODEBUG: Go 1.24+ listens with MPTCP by default, and such a listener cannot rebind a port that still has
  # TIME_WAIT sockets, so a restart under traffic failed with "address already in use" for about a minute.
  procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray GODEBUG=multipathtcp=0
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  # Transparent mode only when Xray is the active protocol (VLESS/SOCKS5/HTTP); with Hysteria,
  # Naive or WireGuard active, a manually started Xray must not steer traffic.
  case "$(cat /etc/xray/proto 2>/dev/null)" in
    hy2|naive|wg) /etc/xray/tproxy.sh down;;
    *) if [ -f /etc/xray/tproxy.disabled ]; then /etc/xray/tproxy.sh down; else /etc/xray/tproxy.sh up; fi;;
  esac
}
stop_service() {
  /etc/xray/tproxy.sh down
}
